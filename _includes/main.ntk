<!DOCTYPE html>
<html lang="en">

<head>
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">
  {% endif %}<meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- GitHub Pages serves /about.html at /about too; tell search engines which address is the real one. -->
  {% if page.url != "/404.html" %}<link rel="canonical" href="{{ site.url }}{{ page.url | cleanUrl }}">
  {% endif %}<!-- Link previews on Facebook, LinkedIn, iMessage, Slack, etc. -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | cleanUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:image:alt" content="{{ site.name }} in performance">
  {% if description %}<meta property="og:description" content="{{ description }}">
  {% endif %}<meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
  <link rel="stylesheet" type="text/css" href="{{ '/styles/navbar.css' | fingerprint }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
  <!-- Global site tag (gtag.js) - Google Ads: 593551022 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-593551022"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'AW-593551022');

</script>
  <link rel="stylesheet" type="text/css" href="{{ '/styles/main.css' | fingerprint }}">
  <link rel="stylesheet" type="text/css" href="{{ '/styles/footer.css' | fingerprint }}">
  <!-- this adds instagram, fb, etc. icons -->
  <script src="https://kit.fontawesome.com/1e86972b80.js" crossorigin="anonymous"></script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SLMVDHBTBP"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-SLMVDHBTBP');
  </script>
  {% block headTags %}
  {% endblock %}
</head>

<body class="{{ 'is-home' if page.url == '/' }}{{ ' has-banner' if banner }}" onload="document.body.style.opacity='1'">
  <div id="rnb">
    <div class="navcontainer">
      {# The homepage shows the name large over its video, so the menu bar there
         has no logo; every other page links home with the lettering. #}
      {% if page.url != "/" %}
      <div class="home" id="header_logo">
        <a href="/"><img class="nav-wordmark" src="/images/ec-wordmark.svg" alt="Ensemble Continuo, chamber choir — home" /></a>
      </div>
      {% endif %}
      <input type="checkbox" id="menu-toggle" class="menu-checkbox" aria-label="Toggle Navigation">
      <label for="menu-toggle" class="hamburger">&#9776;</label>
      <nav class="stroke">
        <div class="pages">
          <ul>
            <li>
              <h3><a href="/performances">Performances</a></h3>
            </li>
            <li>
              <h3><a href="/about">About us</a></h3>
            </li>
            <li>
              <h3><a href="/media">Media</a></h3>
            </li>
              <li>
              <h3><a href="/members">Members</a></h3>
            </li>
            <li>
              <h3><a href="/faqs">FAQs</a></h3>
            </li>
            <li>
              <h3><a href="/auditions">Join us</a></h3>
            </li>
            <li>
              <h3><a href="/contact">Contact us</a></h3>
            </li>
            <li>
              <h3><a href="/donate">Donate</a></h3>
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </div>
  {# Inner pages open with a choir photograph and the page title over it.
     Set "banner" (an image path) and "bannerTitle" in a page's front matter;
     "bannerPosition" moves the crop, e.g. "50% 30%". #}
  {% if banner %}
  <header class="page-banner">
    <img src="{{ banner }}" alt="" style="object-position: {{ bannerPosition or 'center' }}">
    <div class="page-banner__inner">
      <div class="container">
        <p class="page-banner__eyebrow">Ensemble Continuo</p>
        <h1>{{ bannerTitle }}</h1>
      </div>
    </div>
  </header>
  {% endif %}
  {% block content %}
  {% if noWrapper %}
  {{ content | safe }}
  {% else %}
  <div id="maintext" class="container">
    {{ content | safe }}
  </div>
  {% endif %}
  {% endblock %}
  {% if not noFooter %}
  {% include "footer.ntk" %}
  {% endif %}
</body>

</html>