---
title: "Choir Concerts in the Bay Area | Ensemble Continuo"
description: "Upcoming concerts and past programmes from Ensemble Continuo, a Bay Area chamber choir, with venues, dates and ticket links."
layout: main.ntk
banner: /images/media/stanford-memorial-church.jpg
bannerPosition: "50% 70%"
bannerTitle: Performances
---

{% block headTags %}
<link rel="stylesheet" type="text/css" href="{{ '/styles/performances.css' | fingerprint }}">
{%- set upcoming = performances | upcomingPerfs %}
{%- if upcoming.length %}
<script type="application/ld+json">
[
{%- for perf in upcoming %}
  {
    "@context": "https://schema.org",
    "@type": "MusicEvent",
    "name": {{ perf.title | dump | safe }},
    "startDate": {{ perf.startDateIso | dump | safe }},
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "image": {{ (site.url + perf.imgUrl) | dump | safe }},
    {%- if perf.description %}
    "description": {{ perf.description | striptags | dump | safe }},
    {%- endif %}
    "location": {
      "@type": "Place",
      "name": {{ perf.location | dump | safe }}
      {%- if perf.locationUrl %},
      "url": {{ perf.locationUrl | dump | safe }}
      {%- endif %}
    },
    "performer": {
      "@type": "MusicGroup",
      "name": {{ site.name | dump | safe }},
      "url": {{ site.url | dump | safe }}
    },
    "organizer": {
      "@type": "MusicGroup",
      "name": {{ site.name | dump | safe }},
      "url": {{ site.url | dump | safe }}
    }
    {%- if perf.ticketsUrl or perf.free %},
    "offers": {
      "@type": "Offer",
      "url": {{ (perf.ticketsUrl or site.url + "/performances") | dump | safe }},
      {%- if perf.free %}
      "price": 0,
      "priceCurrency": "USD",
      {%- endif %}
      "availability": "https://schema.org/InStock"
    }
    {%- endif %}
  }{{ "," if not loop.last }}
{%- endfor %}
]
</script>
{%- endif %}
{% endblock %}

{% macro performanceCard(perf) %}
<div class="col perf-card-col">
  <div class="card h-100">
    {% if perf.ticketsUrl and perf.category == "upcoming" %}
    <a href="{{ perf.ticketsUrl }}" target="_blank">
      <img src="{{ perf.imgUrl }}" class="card-img-top" alt="{{ perf.title }}">
    </a>
    {% else %}
    <img src="{{ perf.imgUrl }}" class="card-img-top" alt="{{ perf.title }}">
    {% endif %}
    <div class="card-body">
      <h5 class="card-title">{{ perf.title }}</h5>
      <h6 class="card-subtitle mb-2 text-muted">{{ perf.date }}</h6>
      <h6 class="card-subtitle mb-2 text-muted">
        {% if perf.locationUrl %}
        <a href="{{ perf.locationUrl }}" target="_blank">{{ perf.location }}</a>
        {% else %}
        {{ perf.location }}
        {% endif %}
      </h6>

      <p class="card-text">{{ perf.description | safe }}</p>

      {% if perf.ticketsUrl and perf.category == "upcoming" %}
      <p><a href="{{ perf.ticketsUrl }}" id="link" class="card-link" target="_blank">Get a ticket</a>.</p>
      {% endif %}

      {% if perf.concertProgramUrl %}
      <p>Read the <a href="{{ perf.concertProgramUrl }}" id="link" class="card-link" target="_blank">concert
          program</a>.</p>
      {% endif %}
    </div>
  </div>
</div>
{% endmacro %}

{% macro performanceRows(perfs) %}
{% for row in perfs %}
<div class="row perf-row">
  {% for event in row %}
  <div class="column perf-column">
    {{ performanceCard(event) }}
  </div>
  {% endfor %}

  {% if row | length == 1 %}
  <div class="column-spacer perf-column"></div>
  {% endif %}
</div>
{% endfor %}
{% endmacro %}

{% macro performanceList(perfs) %}
<ul>
{% for perf in perfs %}
<li><strong>{{ perf.title }}</strong> - {{ perf.date }} at {{ perf.location }} - {{ perf.description | safe }}

  {% if perf.concertProgramUrl %}
  Read the <a href="{{ perf.concertProgramUrl }}" id="link" class="card-link" target="_blank">concert
    program</a>.
  {% endif %}

</li>
{% endfor %}
</ul>
{% endmacro %}

{# Mailchimp sign-up; posts straight to Mailchimp, which shows its own
   confirmation page. Field names must stay as Mailchimp expects. #}
<form class="signup-box" action="https://ensemble-continuo.us22.list-manage.com/subscribe/post?u=fdf6765d2687403e924ccc48f&amp;id=b637d06d3f&amp;f_id=00cac0e1f0"
  method="post" target="_self">
  <div class="signup-box__text">
    <h2 class="signup-box__title">Hear about our upcoming performances</h2>
  </div>
  <div class="signup-box__field">
    <label class="sr-only" for="mce-EMAIL">Email address</label>
    <input type="email" name="EMAIL" id="mce-EMAIL" placeholder="Your email address" required autocomplete="email">
    <button type="submit" name="subscribe">Subscribe</button>
  </div>
  {# Spam trap: hidden from people, filled in only by bots. #}
  <div aria-hidden="true" style="position: absolute; left: -5000px;">
    <input type="text" name="b_fdf6765d2687403e924ccc48f_b637d06d3f" tabindex="-1" value="">
  </div>
</form>


<h2>Upcoming</h2>
<div id="upcoming_perfs">
  {{ performanceRows(performances | upcomingPerfs | batch(2)) }}
</div>

<h2>Past</h2>
<div id="past_perfs">
  {{ performanceRows(performances | recentPerfs | batch(2)) }}
</div>

<h2>Older performances</h2>
<div id="historical_perfs">
  {{ performanceList(performances | historicalPerfs) }}
</div>
