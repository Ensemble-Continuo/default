---
title: "Ensemble Continuo | Bay Area Chamber Choir"
description: "A classical chamber choir based in Palo Alto, singing repertoire from the Renaissance to the present at venues across the Bay Area."
layout: main.ntk
noWrapper: true # Ensures video takes up remaining space with no padding
---

{% block headTags %}
<link rel="stylesheet" type="text/css" href="{{ '/styles/home.css' | fingerprint }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": {{ site.name | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "logo": {{ (site.url + site.logo) | dump | safe }},
  "image": {{ (site.url + site.ogImage) | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "foundingDate": {{ site.foundingDate | dump | safe }},
  "genre": ["Classical music", "Choral music"],
  "areaServed": "San Francisco Bay Area",
  "taxID": {{ site.taxId | dump | safe }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ site.address.street | dump | safe }},
    "addressLocality": {{ site.address.locality | dump | safe }},
    "addressRegion": {{ site.address.region | dump | safe }},
    "postalCode": {{ site.address.postalCode | dump | safe }},
    "addressCountry": {{ site.address.country | dump | safe }}
  },
  "sameAs": {{ site.sameAs | dump | safe }}
}
</script>
{% endblock %}

{% block content %}
<script>
  // The video starts muted (browsers only autoplay silent video); the button
  // and a click on the video switch the sound on and off.
  function toggleSound() {
    var video = document.getElementById("bgVideo");
    var button = document.getElementById("sound-toggle");
    video.muted = !video.muted;
    if (!video.muted) video.play();
    button.querySelector("span").textContent = video.muted ? "Turn sound on" : "Turn sound off";
    button.querySelector("i").className = video.muted ? "fas fa-volume-up" : "fas fa-volume-mute";
  }
</script>

{% set upcoming = performances | upcomingPerfs %}

{# The video fills the screen below the menu, with the choir's name over it.
   The clip is "and the swallow" by Caroline Shaw, trimmed to start after its
   burned-in title. #}
<div id="videoBackground" class="hero">
  <video id="bgVideo" autoplay muted playsinline loop preload="auto" poster="/images/and_the_swallow_cover.jpg"
    onclick="toggleSound()">
    <source src="{{ '/videos/and_the_swallow.webm' | fingerprint }}" type="video/webm">
  </video>
  <div class="hero__shade"></div>

  <header class="hero__title">
    <p class="hero__place">Palo Alto, California</p>
    <h1><img class="hero__wordmark" src="/images/ec-wordmark.svg" alt="Ensemble Continuo, chamber choir"></h1>
    <figure class="hero__quote">
      <blockquote>&ldquo;It is rare to hear a performance of such artistry from a community choir.&rdquo;</blockquote>
      <figcaption>
        Jens Ibsen,
        <a href="https://www.sfcv.org/articles/review/amateur-singers-uncommon-ambition-ensemble-continuo-takes-frank-martin"
          target="_blank" rel="noopener"><cite>San Francisco Classical Voice</cite></a>
      </figcaption>
    </figure>
    <button type="button" class="sound-pill" id="sound-toggle" onclick="toggleSound()">
      <i class="fas fa-volume-up"></i> <span>Turn sound on</span>
    </button>
  </header>

  {# The whole card links to the ticket page, or to Performances if there is
     none yet (see .next-concert in main.css). #}
  {% if upcoming | length > 0 %}
  {% set nextPerf = upcoming | first %}
  <aside class="next-concert" aria-label="Next concert">
    <button type="button" class="next-concert__close" aria-label="Hide next concert"
      onclick="this.closest('.next-concert').remove()">&times;</button>
    <a class="next-concert__link"
      {% if nextPerf.ticketsUrl %}href="{{ nextPerf.ticketsUrl }}" target="_blank" rel="noopener"{% else %}href="/performances"{% endif %}>
      <img class="next-concert__img" src="{{ nextPerf.imgUrl }}" alt="">
      <div class="next-concert__body">
        <div class="next-concert__eyebrow">Next concert</div>
        <div class="next-concert__title">{{ nextPerf.title }}</div>
        <div class="next-concert__when">{{ nextPerf | concertWhen }}</div>
        <div class="next-concert__where">{{ nextPerf.location }}</div>
        <span class="next-concert__cta">{{ "Get tickets" if nextPerf.ticketsUrl else "See details" }} &rarr;</span>
      </div>
    </a>
  </aside>
  {% endif %}
</div>

{% if upcoming | length > 0 %}
<section class="home-section">
  <div class="container">
    <div class="home-section__head">
      <h2>Upcoming concerts</h2>
      <a href="/performances">All performances &rarr;</a>
    </div>
    <div class="home-concerts">
      {% for p in upcoming %}{% if loop.index <= 3 %}
      <a class="home-concert" {% if p.ticketsUrl %}href="{{ p.ticketsUrl }}" target="_blank" rel="noopener"{% else %}href="/performances"{% endif %}>
        <img src="{{ p.imgUrl }}" alt="" loading="lazy">
        <span class="home-concert__when">{{ p | concertWhen }}</span>
        <span class="home-concert__title">{{ p.title }}</span>
        <span class="home-concert__where">{{ p.location }}</span>
        <span class="home-concert__cta">{{ "Get tickets" if p.ticketsUrl else "Details" }} &rarr;</span>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set video = media.videos | first %}
<section class="home-section home-section--dark">
  <div class="container home-watch">
    <a class="home-watch__thumb" href="/media" aria-label="Watch {{ video.title }}">
      <img src="/images/media/yt-{{ video.id }}.jpg" alt="" loading="lazy">
      <span class="home-watch__play"></span>
    </a>
    <div>
      <span class="home-eyebrow">Watch &amp; listen</span>
      <h2>{{ video.title }}</h2>
      <p>{{ video.meta }}</p>
      <a class="home-btn home-btn--light" href="/media">See all {{ media.videos | length }} recordings &rarr;</a>
    </div>
  </div>
</section>

<section class="home-section home-signup">
  <div class="container">
    <h2>Hear about our next concert first</h2>
    <p>A short email before each concert.</p>
    <a class="home-btn" href="https://ensemble-continuo.us22.list-manage.com/subscribe?u=fdf6765d2687403e924ccc48f&amp;id=b637d06d3f"
      target="_blank" rel="noopener">Join our mailing list</a>
    <a class="home-btn home-btn--ghost" href="/auditions">Sing with us</a>
  </div>
</section>

{% endblock %}
