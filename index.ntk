---
title: "Ensemble Continuo | Bay Area Chamber Choir"
description: "A classical chamber choir based in Palo Alto, singing repertoire from the Renaissance to the present at venues across the Bay Area."
layout: main.ntk
noWrapper: true # Ensures video takes up remaining space with no padding
---

{% block headTags %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": {{ site.name | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "logo": {{ (site.url + site.logo) | dump | safe }},
  "image": {{ (site.url + site.ogImage) | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "foundingDate": {{ site.foundingDate | dump | safe }},
  "genre": ["Classical music", "Choral music"],
  "areaServed": "San Francisco Bay Area",
  "taxID": {{ site.taxId | dump | safe }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ site.address.street | dump | safe }},
    "addressLocality": {{ site.address.locality | dump | safe }},
    "addressRegion": {{ site.address.region | dump | safe }},
    "postalCode": {{ site.address.postalCode | dump | safe }},
    "addressCountry": {{ site.address.country | dump | safe }}
  },
  "sameAs": {{ site.sameAs | dump | safe }}
}
</script>
{% endblock %}

{% block content %}
<!-- Video controls -->
<script>
  function toggleMute() {
    var video = document.getElementById("bgVideo");
    //var button = document.getElementById("muteButton");
    if (video.muted) {
      video.muted = false;
      //button.innerHTML = "Mute";
    } else {
      video.muted = true;
      //button.innerHTML = "Unmute";
    }
  }
</script>

<div class="index-header">
  <div class="main">
    <h2 class="title"><b>ENSEMBLE CONTINUO</b></h2>
    <h3 id="headline">We are a classical chamber choir based in Palo Alto, California. </h3>
    <a href="https://www.instagram.com/ensemblecontinuo/" target="_blank">
      <i id="instagram" class="fab fa-instagram fa-3x" data-toggle="tooltip" data-placement="bottom"
        title="Instagram"></i>
    </a>
    <a href="https://www.youtube.com/@ensemblecontinuo468" target="_blank">
      <i id="youtube" class="fab fa-youtube fa-3x" data-toggle="tooltip" data-placement="bottom" title="YouTube"></i>
    </a>
    <a href="https://www.facebook.com/profile.php?id=61560800301152" target="_blank">
      <i id="facebook" class="fab fa-facebook fa-3x" data-toggle="tooltip" data-placement="bottom" title="Facebook"></i>
    </a>
    <a href="https://ensemble-continuo.us22.list-manage.com/subscribe?u=fdf6765d2687403e924ccc48f&id=b637d06d3f">
      <i id="mailchimp" class="fa fa-envelope fa-3x" data-toggle="tooltip" data-placement="bottom"
        title="Subscribe to our mailing list"></i>
    </a>
    <a href="/contact">
      <i id="email" class="fas fa-reply fa-3x" data-toggle="tooltip" data-placement="bottom" title="Contact us"></i>
    </a>
    <br />
    <h4 id="instruction">
      Click below to hear And The Swallow by Caroline Shaw. Full recording on <a
        href="https://www.youtube.com/watch?v=IfXHkO8XKhQ" target="_blank">YouTube</a>.<br>
    </h4>
  </div>
</div>
<div id="videoBackground">
  {# Review quote overlaid on the hero video (see .video-quote in main.css). #}
  <figure class="video-quote">
    <blockquote>&ldquo;It is rare to hear a performance of such artistry from a community choir.&rdquo;</blockquote>
    <figcaption>
      Jens Ibsen,
      <a href="https://www.sfcv.org/articles/review/amateur-singers-uncommon-ambition-ensemble-continuo-takes-frank-martin"
        target="_blank" rel="noopener"><cite>San Francisco Classical Voice</cite></a>
    </figcaption>
  </figure>
  <video id="bgVideo" autoplay muted playsinline loop preload="auto" poster="/images/and_the_swallow_cover.jpg"
    onclick="toggleMute()">
    <source src="/videos/and_the_swallow.webm" type="video/webm">
    Your browser does not support HTML5 video.
  </video>

  {# Pinned over the hero video (see .next-concert in main.css). The whole
     card links to the ticket page, or to Performances if there is none yet. #}
  {% set upcoming = performances | upcomingPerfs %}
  {% if upcoming | length > 0 %}
  {% set nextPerf = upcoming | first %}
  <aside class="next-concert" aria-label="Next concert">
    <button type="button" class="next-concert__close" aria-label="Hide next concert"
      onclick="this.closest('.next-concert').remove()">&times;</button>
    <a class="next-concert__link"
      {% if nextPerf.ticketsUrl %}href="{{ nextPerf.ticketsUrl }}" target="_blank" rel="noopener"{% else %}href="/performances"{% endif %}>
      <img class="next-concert__img" src="{{ nextPerf.imgUrl }}" alt="">
      <div class="next-concert__body">
        <div class="next-concert__eyebrow">Next concert</div>
        <div class="next-concert__title">{{ nextPerf.title }}</div>
        <div class="next-concert__when">{{ nextPerf | concertWhen }}</div>
        <div class="next-concert__where">{{ nextPerf.location }}</div>
        <span class="next-concert__cta">{{ "Get tickets" if nextPerf.ticketsUrl else "See details" }} &rarr;</span>
      </div>
    </a>
  </aside>
  {% endif %}
</div>

{% endblock %}