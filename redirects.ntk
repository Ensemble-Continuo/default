---
# Pages used to live at /pages/<name>.html. Keep those addresses working for
# old links and search results by sending visitors to the new location.
pagination:
  data: redirects
  size: 1
  alias: redirect
redirects:
  - { from: performances, to: /performances }
  - { from: about_us, to: /about }
  - { from: members, to: /members }
  - { from: faqs, to: /faqs }
  - { from: join_us, to: /auditions }
  - { from: contact_us, to: /contact }
  - { from: donate, to: /donate }
permalink: "/pages/{{ redirect.from }}.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Redirecting…</title>
  <link rel="canonical" href="{{ site.url }}{{ redirect.to }}">
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
</head>
<body>
  <p>This page has moved to <a href="{{ redirect.to }}">{{ site.url }}{{ redirect.to }}</a>.</p>
</body>
</html>
